# LLM sağlayıcı (varsayılan: anthropic)
LLM_PROVIDER=anthropic
# Anthropic API anahtarı — alternatif: Ayarlar ekranından gir (proje dışı gizli dosyaya yazılır)
# ANTHROPIC_API_KEY=sk-ant-...
# Platform sahibi e-postası (varsayılan: cem@konum.local)
# KONUM_PLATFORM_SAHIBI=cem@konum.local
# Tam SQLite yedeği uçları (/admin/yedek, /admin/yedek/ozet) için taşıyıcı anahtar.
# Tanımlı değilse uçlar 404 döner (gizli kalır). Üret: openssl rand -hex 32
# KONUM_YEDEK_ANAHTARI=
